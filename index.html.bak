      <img id="lightbox-img" src="" alt="Enlarged View" style="width: 100%; max-height: 70vh; object-fit: contain; border-radius: var(--radius-sm); margin-bottom: 15px;">
      <div style="color: var(--color-white); text-align: center;">
        <h3 id="lightbox-title" style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--color-gold-pale); margin-bottom: 5px;"></h3>
        <p id="lightbox-sub" style="font-size: 0.85rem; color: rgba(255,255,255,0.7); margin-bottom: 15px;"></p>
        <button id="lightbox-wa-btn" class="btn btn-whatsapp" style="margin: 0 auto; display: inline-flex;">
          Enquire on WhatsApp
        </button>
      </div>
    </div>
  </div>

  <!-- APPOINTMENT BOOKING & LEAD CAPTURE MODAL -->
  <div id="appointment-modal" class="appointment-modal">
    <div class="appointment-dialog">
      <div class="appointment-header">
        <button type="button" class="appointment-close" onclick="closeBookVisitModal()" aria-label="Close">&times;</button>
        <div class="badge-tag badge-gold" style="margin-bottom: 6px; font-size: 0.7rem;">Powai Naka, Satara • Estd. 1987</div>
        <h3>Book Showroom Visit</h3>
        <p>Schedule your personalized trial & shopping session. We will keep your sizes and preferred styles ready!</p>
      </div>
      <div class="appointment-body">
        <form id="appointment-form" onsubmit="submitAppointmentForm(event)">
          <div class="apt-row">
            <div class="apt-form-group">
              <label class="apt-form-label">Full Name <span class="req">*</span></label>
              <input type="text" id="apt-name" class="apt-form-input" placeholder="e.g. Rahul Patil" required>
            </div>
            <div class="apt-form-group">
              <label class="apt-form-label">WhatsApp / Mobile Number <span class="req">*</span></label>
              <input type="tel" id="apt-phone" class="apt-form-input" placeholder="e.g. 98220 12345" required>
            </div>
          </div>

          <div class="apt-form-group">
            <label class="apt-form-label">Your Area / Address (Satara / Nearby) <span class="req">*</span></label>
            <input type="text" id="apt-address" class="apt-form-input" placeholder="e.g. Powai Naka, Sadar Bazar, Karad, Wai..." required>
          </div>

          <div class="apt-row">
            <div class="apt-form-group">
              <label class="apt-form-label">Preferred Date of Visit <span class="req">*</span></label>
              <input type="date" id="apt-date" class="apt-form-input" required>
            </div>
            <div class="apt-form-group">
              <label class="apt-form-label">Preferred Time Slot <span class="req">*</span></label>
              <select id="apt-time" class="apt-form-select" required>
                <option value="">Select Time Slot</option>
                <option value="Morning (9:30 AM – 1:00 PM)">Morning (9:30 AM – 1:00 PM)</option>
                <option value="Afternoon (1:00 PM – 5:00 PM)">Afternoon (1:00 PM – 5:00 PM)</option>
                <option value="Evening (5:00 PM – 9:00 PM)">Evening (5:00 PM – 9:00 PM)</option>
              </select>
            </div>
          </div>

          <div class="apt-form-group">
            <label class="apt-form-label">Clothing Variety Interested In: <span class="req">*</span></label>
            <div class="interest-grid">
              <label class="interest-item">
                <input type="checkbox" name="clothing_interest" value="Bomber & TPU Jackets">
                <span>Bomber & TPU Jackets</span>
              </label>
              <label class="interest-item">
                <input type="checkbox" name="clothing_interest" value="Cotton & Printed Shirts">
                <span>Cotton & Printed Shirts</span>
              </label>
              <label class="interest-item">
                <input type="checkbox" name="clothing_interest" value="Branded Denim & Jeans">
                <span>Branded Denim & Jeans</span>
              </label>
              <label class="interest-item">
                <input type="checkbox" name="clothing_interest" value="T-Shirt Combos (3 for ₹800)">
                <span>T-Shirt Combos (3 for ₹800)</span>
              </label>
              <label class="interest-item">
                <input type="checkbox" name="clothing_interest" value="Imported Leather Jackets">
                <span>Imported Leather Jackets</span>
              </label>
              <label class="interest-item">
                <input type="checkbox" name="clothing_interest" value="Festive & Wedding Ethnic">
                <span>Festive & Wedding Ethnic</span>
              </label>
            </div>
          </div>

          <div class="apt-form-group">
            <label class="apt-form-label">Special Request / Size Notes (Optional)</label>
            <input type="text" id="apt-notes" class="apt-form-input" placeholder="e.g. Size L/XL, looking for wedding party wear...">
          </div>

          <button type="submit" class="btn btn-primary apt-submit-btn">
            <span>Confirm Showroom Appointment</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <p class="apt-privacy-note">🔒 Your details are 100% confidential and directly reserved for your personal visit at Hiramoti Collection.</p>
        </form>

        <div id="appointment-success" style="display: none;" class="booking-success-card">
          <div class="booking-success-icon">✓</div>
          <h4>Appointment Confirmed!</h4>
          <p>Thank you <strong id="success-name"></strong>! Your appointment has been recorded. Our staff at Powai Naka will be delighted to assist you.</p>
          <div id="success-summary" class="booking-summary-box"></div>
          <a id="success-wa-btn" href="#" target="_blank" rel="noopener" class="btn btn-whatsapp" style="width: 100%; justify-content: center; padding: 12px; font-weight: 700;">
            Open in WhatsApp to Confirm Now
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Header Scroll Effect & Mobile Drawer
    document.addEventListener("DOMContentLoaded", function() {
      var header = document.querySelector(".site-header");
      var mobileBtn = document.querySelector(".mobile-toggle");
      var drawer = document.querySelector(".mobile-drawer");
      var drawerClose = document.querySelector(".drawer-close");
      var overlay = document.querySelector(".drawer-overlay");

      window.addEventListener("scroll", function() {
        if (window.scrollY > 40) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      });

      if (mobileBtn && drawer && overlay) {
        mobileBtn.addEventListener("click", function() {
          drawer.classList.add("open");
          overlay.classList.add("open");
        });
        var closeMenu = function() {
          drawer.classList.remove("open");
          overlay.classList.remove("open");
        };
        if (drawerClose) drawerClose.addEventListener("click", closeMenu);
        overlay.addEventListener("click", closeMenu);
      }

      // Reel Embed Modal logic
      var reelModal = document.getElementById("reel-embed-modal");
      var reelIframe = document.getElementById("reel-iframe");
      var closeReel = document.getElementById("close-reel-modal");

      window.openReelEmbed = function(embedUrl) {
        if (reelModal && reelIframe) {
          reelIframe.src = embedUrl;
          reelModal.classList.add("active");
          document.body.style.overflow = "hidden";
        }
      };

      if (closeReel) {
        closeReel.addEventListener("click", function() {
          if (reelModal && reelIframe) {
            reelIframe.src = "";
            reelModal.classList.remove("active");
            document.body.style.overflow = "";
          }
        });
      }

      if (reelModal) {
        reelModal.addEventListener("click", function(e) {
          if (e.target === reelModal) {
            closeReel.click();
          }
        });
      }

      // Lightbox logic
      var lightbox = document.getElementById("gallery-lightbox");
      var lightboxImg = document.getElementById("lightbox-img");
      var lightboxTitle = document.getElementById("lightbox-title");
      var lightboxSub = document.getElementById("lightbox-sub");
      var lightboxWa = document.getElementById("lightbox-wa-btn");
      var closeLb = document.getElementById("close-lightbox");

      window.openLightbox = function(imgSrc, title, subtitle) {
        if (lightbox && lightboxImg) {
          lightboxImg.src = imgSrc;
          lightboxTitle.innerText = title;
          lightboxSub.innerText = subtitle;
          lightboxWa.onclick = function() {
            var msg = encodeURIComponent("Hello Hiramoti Collection Satara! I saw this in your gallery: *" + title + "*. Please share price & availability.");
            window.open("https://wa.me/919595989815?text=" + msg, "_blank");
          };
          lightbox.style.display = "flex";
          document.body.style.overflow = "hidden";
        }
      };

      if (closeLb) {
        closeLb.addEventListener("click", function() {
          lightbox.style.display = "none";
          document.body.style.overflow = "";
        });
      }

      // Appointment Booking Modal Handlers
      window.openBookVisitModal = function() {
        var modal = document.getElementById("appointment-modal");
        if (modal) {
          modal.classList.add("active");
          document.body.style.overflow = "hidden";
          var dateInput = document.getElementById("apt-date");
          if (dateInput && !dateInput.value) {
            var today = new Date().toISOString().split("T")[0];
            dateInput.min = today;
            dateInput.value = today;
          }
        }
      };

      window.closeBookVisitModal = function() {
        var modal = document.getElementById("appointment-modal");
        if (modal) {
          modal.classList.remove("active");
          document.body.style.overflow = "";
        }
      };

      window.submitAppointmentForm = function(e) {
        e.preventDefault();
        var name = document.getElementById("apt-name").value.trim();
        var phone = document.getElementById("apt-phone").value.trim();
        var address = document.getElementById("apt-address").value.trim();
        var date = document.getElementById("apt-date").value;
        var time = document.getElementById("apt-time").value;
        var notes = document.getElementById("apt-notes") ? document.getElementById("apt-notes").value.trim() : "";
        
        var checkedBoxes = document.querySelectorAll("input[name='clothing_interest']:checked");
        var interests = [];
        checkedBoxes.forEach(function(cb) { interests.push(cb.value); });
        if (interests.length === 0) interests.push("General Showroom Collection");

        var leadData = {
          name: name,
          phone: phone,
          address: address,
          date: date,
          time: time,
          interests: interests,
          notes: notes,
          timestamp: new Date().toISOString()
        };

        try {
          var existing = JSON.parse(localStorage.getItem("HMC_APPOINTMENTS") || "[]");
          existing.push(leadData);
          localStorage.setItem("HMC_APPOINTMENTS", JSON.stringify(existing));
        } catch(err) {
          console.error("Storage error:", err);
        }

        var msg = "*✨ NEW SHOWROOM VISIT APPOINTMENT ✨*\n" +
          "• *Customer Name:* " + name + "\n" +
          "• *Phone:* " + phone + "\n" +
          "• *City/Address:* " + address + "\n" +
          "• *Date of Visit:* " + date + "\n" +
          "• *Time Slot:* " + time + "\n" +
          "• *Interested In:* " + interests.join(", ") + "\n" +
          (notes ? ("• *Special Notes:* " + notes + "\n") : "") +
          "• *Location:* Hiramoti Collection, Powai Naka, Satara";

        var waUrl = "https://wa.me/919595989815?text=" + encodeURIComponent(msg);

        var form = document.getElementById("appointment-form");
        var successCard = document.getElementById("appointment-success");
        var successName = document.getElementById("success-name");
        var successSummary = document.getElementById("success-summary");
        var successWaBtn = document.getElementById("success-wa-btn");

        if (form && successCard) {
          form.style.display = "none";
          successName.innerText = name;
          successSummary.innerHTML = "<strong>Date:</strong> " + date + "<br>" +
            "<strong>Time:</strong> " + time + "<br>" +
            "<strong>Address:</strong> " + address + "<br>" +
            "<strong>Interests:</strong> " + interests.join(", ");
          successWaBtn.href = waUrl;
          successCard.style.display = "block";
        }

        window.open(waUrl, "_blank");
      };

      // Hero Video Sound Toggle
      var heroVideo = document.getElementById("hero-video");
      var heroSoundBtn = document.getElementById("hero-sound-toggle");
      var heroSoundMuted = document.getElementById("hero-sound-muted");
      var heroSoundUnmuted = document.getElementById("hero-sound-unmuted");

      if (heroVideo && heroSoundBtn) {
        heroSoundBtn.addEventListener("click", function() {
          heroVideo.muted = !heroVideo.muted;
          if (heroVideo.muted) {
            heroSoundMuted.style.display = "block";
            heroSoundUnmuted.style.display = "none";
          } else {
            heroSoundMuted.style.display = "none";
            heroSoundUnmuted.style.display = "block";
          }
        });
      }

      document.addEventListener("click", function(e) {
        var aptModal = document.getElementById("appointment-modal");
        if (aptModal && e.target === aptModal) {
          closeBookVisitModal();
        }
      });

      // About Page Logo Switcher (Marathi / English CorelDRAW Artwork)
      window.setAboutLogo = function(lang) {
        var img = document.getElementById("about-brand-logo");
        var title = document.getElementById("about-logo-title");
        var btnMr = document.getElementById("btn-mr");
        var btnEn = document.getElementById("btn-en");
        if (!img) return;

        if (lang === "mr") {
          img.src = "assets/images/hiramoti_logo_marathi_framed.png";
          if (title) title.innerText = "हिरामोती कलेक्शन";
          if (btnMr && btnEn) {
            btnMr.className = "btn btn-gold";
            btnEn.className = "btn btn-outline";
          }
        } else {
          img.src = "assets/images/hiramoti_logo_english_framed.png";
          if (title) title.innerText = "HIRAMOTI COLLECTION";
          if (btnMr && btnEn) {
            btnEn.className = "btn btn-gold";
            btnMr.className = "btn btn-outline";
          }
        }
      };

      window.toggleAboutLogo = function() {
        var img = document.getElementById("about-brand-logo");
        if (!img) return;
        if (img.src.indexOf("marathi") !== -1) {
          window.setAboutLogo("en");
        } else {
          window.setAboutLogo("mr");
        }
      };
    });
  </script>
  <script src="js/api-bridge.js"></script>
</body>
</html>
