  <!-- LIGHTBOX MODAL FOR GALLERY IMAGES -->
  <div id="gallery-lightbox" class="reel-embed-modal" style="display: none;">
    <div style="position: relative; max-width: 800px; width: 90%; background: var(--color-burgundy-deep); border-radius: var(--radius-md); border: 1.5px solid var(--color-gold); overflow: hidden; padding: 20px; box-shadow: 0 0 50px rgba(0,0,0,0.8);">
